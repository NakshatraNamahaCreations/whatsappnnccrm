PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# embedded = MongoDB saved in backend/data (nothing to install) | or a mongodb:// / Atlas connection string
MONGO_URI=embedded

# baileys = real WhatsApp via QR (linked device) | cloud = official Meta Cloud API | demo = simulated
WA_PROVIDER=baileys
# Days of chat history to keep from what WhatsApp shares on linking (0 = all)
WA_HISTORY_DAYS=0

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# WhatsApp Cloud API (Meta)
WA_API_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=change_me

WA_INVITE_TEMPLATE=meeting_invite

# AI engine: an open model on YOUR OWN GPU server (vLLM). Setup: deploy/gpu-server/README.md
LLM_PROVIDER=openai
# The server address, e.g. https://ai.yourdomain.com or http://<server-ip>:8000
LLM_URL=
# Must match the --api-key the server was started with
LLM_API_KEY=
# Must match the model name the server serves
AI_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
# Must not exceed the server's --max-model-len
AI_CONTEXT=16384
# Chats summarised at the same time
AI_CONCURRENCY=3
# false = only summarise when you click Summarise
AI_AUTO=true
